# =============================================================================
# Every variable this project reads, in one place.
#
# They are set in three different places depending on what they are:
#
#   1. Client build vars (VITE_*)  -> .env.local for dev, and your Cloudflare
#                                     Worker build settings for deploys. These
#                                     are BAKED INTO THE BUNDLE and visible to
#                                     anyone who opens the page. Never put a
#                                     secret here.
#   2. Worker vars                 -> wrangler.jsonc "vars", or the Cloudflare
#                                     dashboard (Worker > Settings > Variables).
#                                     Not secret, but they ARE committed if you
#                                     put them in wrangler.jsonc -- so keep your
#                                     real coordinates in the dashboard instead.
#   3. Worker secrets              -> `npx wrangler secret put NAME`, or
#                                     .dev.vars locally. Never committed.
#
# Copy this file to .env.local and set the VITE_* values you want for dev.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. CLIENT (VITE_*) -- .env.local, or the build environment
# -----------------------------------------------------------------------------

# Serve fixtures instead of calling the Worker. Lets you develop the entire UI
# with no keys and no network. Default: false
VITE_USE_MOCK=false

# How often the board asks the Worker for a new payload, in seconds. The Worker
# decides how stale each source is allowed to be; this is just the heartbeat.
# Default: 60
VITE_POLL_SECONDS=60

# Hours between which the palette dims. Wraps midnight, so 22 -> 7 is valid.
# Default: 22 and 7
VITE_NIGHT_START=22
VITE_NIGHT_END=7

# Hour of the once-a-day full page reload, to clear anything that has drifted
# over a long run. Pick a quiet hour. Default: 4
VITE_RELOAD_HOUR=4

# Burn-in mitigation: how far the board creeps, and how often it steps.
# Set VITE_BURN_IN_PX=0 to disable entirely. Defaults: 6 and 10
VITE_BURN_IN_PX=6
VITE_BURN_IN_MINUTES=10

# The traffic map's own burn-in cycle, inside its tile. It is the largest
# continuous area on the board and draws the same shape every day, so it gets a
# bigger step than the board's -- and a period that does not divide into it, or
# the two stay locked together and cover no more pixels than one of them would.
# Set VITE_MAP_DRIFT_PX=0 to disable. Defaults: 16 and 7
VITE_MAP_DRIFT_PX=16
VITE_MAP_DRIFT_MINUTES=7

# Blank the map between the night hours above rather than dimming it. Nine
# hours a day of not drawing it is worth more than any amount of dimming, and
# there is no traffic to report at 03:00. Default: true
VITE_MAP_HIDE_AT_NIGHT=true

# Used for all date and time formatting, so the board does not depend on the
# TV's own clock being set correctly. Defaults: Europe/London and en-GB
VITE_TIMEZONE=Europe/London
VITE_LOCALE=en-GB


# -----------------------------------------------------------------------------
# 2. WORKER VARS -- wrangler.jsonc "vars", or the Cloudflare dashboard
#
# This file documents every var for local dev. In production most of them come
# from wrangler.jsonc, but the six coordinates below and BIN_SCHEDULE do NOT:
# they are set in the Cloudflare dashboard and deliberately left out of
# wrangler.jsonc, because any key that file lists is re-uploaded and overwrites
# the dashboard value on every deploy. The values here are PLACEHOLDERS -- put
# your real ones in the dashboard, and do not copy them back into
# wrangler.jsonc "vars" or each push will reset them.
# -----------------------------------------------------------------------------

# Drives the morning window and the bin collection dates. Default: Europe/London
TIMEZONE=Europe/London

# Where the forecast is for, and what to call it. The coordinates are
# dashboard-owned in production; only the label ships in wrangler.jsonc.
WEATHER_LAT=51.5000
WEATHER_LON=0.1000
WEATHER_LABEL=Home

# Route endpoints for the commute. Dashboard-owned in production.
HOME_LAT=51.5000
HOME_LON=0.1000
WORK_LAT=51.5100
WORK_LON=0.1200

# Display labels for the two ends of the commute.
COMMUTE_HOME_LABEL=Home
COMMUTE_LABEL=Work

# Morning and afternoon commute windows. During these windows only, the board
# shows one live commute: morning is Home -> Work, afternoon is Work -> Home.
# Outside these windows, the commute tile is hidden entirely.
COMMUTE_MORNING_WINDOW_START=05:30
COMMUTE_MORNING_WINDOW_END=09:00
COMMUTE_AFTERNOON_WINDOW_START=15:00
COMMUTE_AFTERNOON_WINDOW_END=19:00

# Which days the window applies on. 0 = Sunday. Default: weekdays
COMMUTE_DAYS=1,2,3,4,5

# Traffic map. Centre and zoom for the live map that fills the focus slot
# outside commute windows. All four are optional and all four are
# dashboard-owned in production: the zoom in particular is found by trying one
# while looking at the TV, which a var in wrangler.jsonc could not support.
#
# Unset, the map centres on HOME_LAT/HOME_LON at zoom 11. MAP_LAT/MAP_LON only
# move the picture -- they do not move either end of the commute route.
#
# The zoom is clamped to 9-14, however it is arrived at. The floor is the
# traffic layer: Google thins it as you zoom out, and below 10 the tile stops
# being a picture of your area. The ceiling is the opposite failure -- past 14
# only your own streets are left and the surrounding network has fallen off
# the edges. 11 covers roughly 55km across the tile, which from east London
# reaches the M25 both ways.
MAP_LAT=51.5000
MAP_LON=0.1000
MAP_ZOOM=11

# Better than a zoom: name what should sit at the tile's left and right edges,
# as longitudes, and the board derives the zoom from the actual tile width.
# The pair also sets the horizontal centre -- MAP_LON is then unused, though
# MAP_LAT still sets the vertical one. Set both or neither, west below east;
# anything else falls back to MAP_ZOOM. The values here are placeholders.
#
# There is no north/south equivalent, and there cannot be: a map covers ground
# in proportion to its container, so these two fix the vertical extent as well,
# at the tile's 3.4:1 ratio. Sixteen kilometres across is under five deep.
MAP_WEST_LON=0.0500
MAP_EAST_LON=0.2500

# Optional cloud-styled map id. When set, Google uses the style attached to it
# and ignores the dark style this repo ships in src/lib/googleMaps.ts.
# MAP_ID=

# TfL roads. The disruption board these feed is no longer on screen -- the
# traffic map replaced it -- but it is still fetched and still reachable at
# ?focus=tfl. This dashboard is tuned to only monitor the key routes around
# RM13 7YB within roughly 20 miles.
TFL_ROAD_IDS=a12,a13,a406,m25

# TfL modes to report line status for. Keep this as tube so disruption stays
# focused on the core Underground lines.
TFL_LINE_MODES=tube

# CoinGecko coin ids (not ticker symbols) and the currency to price them in.
# Order is preserved on the board. An id CoinGecko does not know costs only
# itself -- that coin is dropped and the rest still render.
CRYPTO_IDS=ethereum,bitcoin,uniswap,chainlink,arbitrum,1inch,sei-network,render-token,solana,ondo-finance
CRYPTO_VS=usd

# Bin provider. "havering" scrapes the council collection-day portal for this
# configured address, then falls back to manual if unavailable.
BIN_PROVIDER=havering

# Recurring collection rules, as a JSON string. Each rule is a set of bin kinds,
# a date you know a collection actually happened on, and how often it repeats.
# Valid kinds: general, recycling, garden, food.
# The example below is the usual alternating fortnightly pattern, and is a
# placeholder: this one is dashboard-owned in production too, and with it unset
# the board simply has no manual fallback behind the scraper.
BIN_SCHEDULE=[{"kinds":["general","food"],"anchor":"2026-01-07","intervalDays":14},{"kinds":["recycling","garden","food"],"anchor":"2026-01-14","intervalDays":14}]

# Serve fixtures from the Worker instead of calling real APIs. Default: false
MOCK=false


# -----------------------------------------------------------------------------
# 3. WORKER SECRETS -- `npx wrangler secret put NAME`, or .dev.vars locally
#
# Both are optional. The board works with neither: weather, disruption, crypto
# and bins are all keyless.
# -----------------------------------------------------------------------------

# Enables the live commute. Without it the commute tile stays on a labelled
# typical fallback and the routing API is never called.
# GOOGLE_ROUTES_API_KEY=

# Optional. CoinGecko's free tier serves us without a key, just rate limited
# harder. A demo key raises that limit.
# COINGECKO_API_KEY=

# Enables the traffic map. Without it the tile says "Not configured" and loads
# nothing at all.
#
# This one is only *kept* secret, not *treated* as secret: it is a Maps
# JavaScript API key, handed to the browser to load Google's script, so it also
# appears in /api/board -- which is public. Restrict it in Google Cloud by HTTP
# referrer to the board's own origin, and to the Maps JavaScript API alone.
# Never reuse GOOGLE_ROUTES_API_KEY here: that one never leaves the Worker.
# GOOGLE_MAPS_BROWSER_KEY=
