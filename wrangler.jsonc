{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-dashboard",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-03",

  // Wrangler runs this before it uploads. Cloudflare's git integration goes
  // straight from `npm install` to the deploy command when the dashboard's
  // Build command field is empty, which leaves dist/client missing and fails
  // the upload -- so the build is declared here instead of depending on a
  // field outside the repo.
  "build": {
    "command": "npm run build"
  },

  "assets": {
    "binding": "ASSETS",
    // The Vite plugin overrides this in the config it generates at
    // dist/daily_dashboard/wrangler.json. It is set here anyway so that a
    // plain `npx wrangler deploy` against this file also works -- that is the
    // default deploy command in Cloudflare's git integration, and without a
    // directory it fails outright.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // Guarantees /api/* reaches the Worker instead of being swallowed by the
    // SPA fallback. Everything else is served straight from assets and never
    // wakes the Worker at all.
    "run_worker_first": ["/api/*"]
  },

  // One tick every 2 minutes. The handler decides per source whether it is
  // actually due, so this stays cheap and commute routing is only called
  // inside the configured morning window.
  "triggers": {
    "crons": ["*/2 * * * *"]
  },

  // Cache for every source. Create your own and paste the id here:
  //   npx wrangler kv namespace create BOARD_KV
  "kv_namespaces": [
    {
      "binding": "BOARD_KV",
      "id": "4a416535b5464ba6a361b5879fac394e"
    }
  ],

  "observability": {
    "enabled": true
  },

  // Without this, wrangler treats this file as the source of truth and
  // overwrites or deletes dashboard-set vars on every deploy -- so the real
  // coordinates set in the dashboard would be reset to the placeholders below
  // by the next push. Keeping real locations out of the repo only works if
  // deploys stop clobbering them.
  "keep_vars": true,

  "vars": {
    "TIMEZONE": "Europe/London",
    "WEATHER_LAT": "51.5000",
    "WEATHER_LON": "0.1000",
    "WEATHER_LABEL": "Home",
    "HOME_LAT": "51.5000",
    "HOME_LON": "0.1000",
    "WORK_LAT": "51.5100",
    "WORK_LON": "0.1200",
    "COMMUTE_LABEL": "Work",
    "COMMUTE_WINDOW_START": "06:00",
    "COMMUTE_WINDOW_END": "09:30",
    "COMMUTE_DAYS": "1,2,3,4,5",
    "TFL_ROAD_IDS": "a12,a13,a406",
    "TFL_LINE_MODES": "tube,dlr,elizabeth-line,overground",
    "CRYPTO_IDS": "bitcoin,ethereum,solana",
    "CRYPTO_VS": "gbp",
    "BIN_PROVIDER": "manual",
    // Placeholder pattern: two fortnightly rounds offset by a week. Replace
    // "anchor" with a date you know a collection actually happened on.
    "BIN_SCHEDULE": "[{\"kinds\":[\"general\",\"food\"],\"anchor\":\"2026-01-07\",\"intervalDays\":14},{\"kinds\":[\"recycling\",\"garden\",\"food\"],\"anchor\":\"2026-01-14\",\"intervalDays\":14}]",
    "MOCK": "false"
  }
}
