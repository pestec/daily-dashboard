{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily-dashboard",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-03",

  // Wrangler runs this before it uploads. Cloudflare's git integration goes
  // straight from `npm install` to the deploy command when the dashboard's
  // Build command field is empty, which leaves dist/client missing and fails
  // the upload -- so the build is declared here instead of depending on a
  // field outside the repo.
  "build": {
    "command": "npm run build"
  },

  "assets": {
    "binding": "ASSETS",
    // The Vite plugin overrides this in the config it generates at
    // dist/daily_dashboard/wrangler.json. It is set here anyway so that a
    // plain `npx wrangler deploy` against this file also works -- that is the
    // default deploy command in Cloudflare's git integration, and without a
    // directory it fails outright.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // Guarantees /api/* reaches the Worker instead of being swallowed by the
    // SPA fallback. Everything else is served straight from assets and never
    // wakes the Worker at all.
    "run_worker_first": ["/api/*"]
  },

  // One tick every 5 minutes. The handler decides per source whether it is
  // actually due, so this stays cheap and commute routing is only called
  // inside the configured commute windows.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Cache for every source. Create your own and paste the id here:
  //   npx wrangler kv namespace create BOARD_KV
  "kv_namespaces": [
    {
      "binding": "BOARD_KV",
      "id": "4a416535b5464ba6a361b5879fac394e"
    }
  ],

  "browser": {
    "binding": "BROWSER"
  },

  "observability": {
    "enabled": true
  },

  // Stops wrangler DELETING dashboard-set vars this file does not mention.
  // It does not stop it overwriting the ones it does: every key in `vars`
  // below is uploaded on each deploy and replaces whatever the dashboard
  // holds. So the vars the README tells you to own in the dashboard -- the
  // real coordinates and your bin schedule -- are deliberately absent from
  // `vars` rather than listed with a placeholder. Listing one here again is
  // what re-arms the reset-on-every-push; worker/config.ts holds the
  // placeholder fallbacks instead.
  "keep_vars": true,

  // WEATHER_LAT/LON, HOME_LAT/LON, WORK_LAT/LON and BIN_SCHEDULE are absent on
  // purpose -- they are dashboard-owned, and keep_vars can only protect a var
  // this block does not name. See worker/config.ts for what an unset one falls
  // back to.
  "vars": {
    "TIMEZONE": "Europe/London",
    "WEATHER_LABEL": "Home",
    "COMMUTE_LABEL": "Work",
    "COMMUTE_HOME_LABEL": "Home",
    "COMMUTE_MORNING_WINDOW_START": "05:30",
    "COMMUTE_MORNING_WINDOW_END": "09:00",
    "COMMUTE_AFTERNOON_WINDOW_START": "15:00",
    "COMMUTE_AFTERNOON_WINDOW_END": "19:00",
    "COMMUTE_DAYS": "1,2,3,4,5",
    "TFL_ROAD_IDS": "a12,a13,a406,m25",
    "TFL_LINE_MODES": "tube",
    "CRYPTO_IDS": "ethereum,bitcoin,uniswap,chainlink,arbitrum,1inch,sei-network,render-token,solana,ondo-finance",
    "CRYPTO_VS": "usd",
    "BIN_PROVIDER": "havering",
    "MOCK": "false"
  }
}
